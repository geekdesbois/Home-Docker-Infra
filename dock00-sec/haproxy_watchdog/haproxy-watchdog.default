# /etc/default/haproxy-watchdog — surcharges du watchdog (tout est optionnel)

# Conteneurs surveillés (syslog et crowdsec n'ont pas de healthcheck : seul l'état running compte)
CONTAINERS="haproxy crowdsec syslog"

# Alertes mail (nécessite un sendmail : apt install dma, smarthost = le Synology)
MAIL_TO="geekdesbois@zonelibre.live"
MAIL_FROM="dock00-sec@terre-du-milieu.org"

# Sonde HTTP CrowdSec (/health répond 200)
PROBE_URL[crowdsec]="http://127.0.0.1:8888/health"

# Validation avant restart (testées : code 0)
VALIDATE_CMD[syslog]="syslog-ng --syntax-only -f /etc/syslog-ng/syslog-ng.conf"
VALIDATE_CMD[crowdsec]="crowdsec -t"