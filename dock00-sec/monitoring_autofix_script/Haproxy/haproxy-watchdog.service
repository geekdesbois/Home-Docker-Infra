[Unit]
Description=Watchdog des conteneurs DMZ (HAProxy) — start/restart si down ou unhealthy
Documentation=file:///usr/local/sbin/haproxy-watchdog.sh
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/haproxy-watchdog.sh
StateDirectory=haproxy-watchdog
TimeoutStartSec=10min
Nice=10
# Durcissement léger (le script parle au socket Docker, donc root de fait)
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
