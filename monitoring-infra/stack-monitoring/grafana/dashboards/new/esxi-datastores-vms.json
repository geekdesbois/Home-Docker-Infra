      "panels": [],
      "title": "Datastores",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 85
              },
              {
                "color": "red",
                "value": 92
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "pluginVersion": "11.1.4",
      "targets": [
        {
          "expr": "max by (ds_name) (100 * (1 - (vmware_datastore_freespace_size{job=\"$job\",dc_name=~\"$dc\",ds_name=~\"$ds\"} / vmware_datastore_capacity_size{job=\"$job\",dc_name=~\"$dc\",ds_name=~\"$ds\"})))",
          "legendFormat": "{{ds_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "title": "Datastore used (%)",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "gbytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.1.4",
      "targets": [
        {
          "expr": "min by (ds_name) (vmware_datastore_freespace_size{job=\"$job\",dc_name=~\"$dc\",ds_name=~\"$ds\"} / 1024^3)",
          "legendFormat": "{{ds_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "title": "Datastore free (GiB) — lowest",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Capacity GiB"
            },
            "properties": [
              {
                "id": "unit",
                "value": "gbytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Free GiB"
            },
            "properties": [
              {
                "id": "unit",
                "value": "gbytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Used %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 85
                    },
                    {
                      "color": "red",
                      "value": 92
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Accessible"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "text": "NO"
                      },
                      "1": {
                        "text": "YES"
                      }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "pluginVersion": "11.1.4",
      "targets": [
        {
          "expr": "max by (ds_name, dc_name) (vmware_datastore_capacity_size{job=\"$job\",dc_name=~\"$dc\",ds_name=~\"$ds\"}) / 1024^3",
          "instant": true,
          "legendFormat": "capacity_gib",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "max by (ds_name, dc_name) (vmware_datastore_freespace_size{job=\"$job\",dc_name=~\"$dc\",ds_name=~\"$ds\"}) / 1024^3",
          "instant": true,
          "legendFormat": "free_gib",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "max by (ds_name, dc_name) (100 * (1 - (vmware_datastore_freespace_size{job=\"$job\",dc_name=~\"$dc\",ds_name=~\"$ds\"} / vmware_datastore_capacity_size{job=\"$job\",dc_name=~\"$dc\",ds_name=~\"$ds\"})))",
          "instant": true,
          "legendFormat": "used_pct",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "max by (ds_name, dc_name) (vmware_datastore_accessible{job=\"$job\",dc_name=~\"$dc\",ds_name=~\"$ds\"})",
          "instant": true,
          "legendFormat": "accessible",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "title": "Datastores table",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "joinByLabels",
          "options": {
            "labels": [
              "ds_name",
              "dc_name"
            ],
            "valueFieldName": "Value"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "Accessible": 5,
              "Capacity GiB": 2,
              "Datacenter": 1,
              "Datastore": 0,
              "Free GiB": 3,
              "Used %": 4
            },
            "renameByName": {
              "accessible": "Accessible",
              "capacity_gib": "Capacity GiB",
              "dc_name": "Datacenter",
              "ds_name": "Datastore",
              "free_gib": "Free GiB",
              "used_pct": "Used %"
            }
          }
        }
      ],
      "type": "table"
    },
