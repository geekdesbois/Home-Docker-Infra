          "show": false
        },
        "showHeader": true
      },
      "pluginVersion": "11.1.4",
      "targets": [
        {
          "expr": "max by (vm_name, dc_name, ds_name, host_name) (vmware_vm_power_state{job=\"$job\",dc_name=~\"$dc\",ds_name=~\"$ds\",vm_name=~\"$vm\"})",
          "instant": true,
          "legendFormat": "power",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "max by (vm_name, dc_name, ds_name, host_name) (vmware_vm_boot_timestamp_seconds{job=\"$job\",dc_name=~\"$dc\",ds_name=~\"$ds\",vm_name=~\"$vm\"})",
          "instant": true,
          "legendFormat": "boot_time",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "title": "VM power state + boot time",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "joinByLabels",
          "options": {
            "labels": [
              "vm_name",
              "host_name",
              "ds_name",
              "dc_name"
            ],
            "valueFieldName": "Value"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "Boot time": 5,
              "Datacenter": 3,
              "Datastore": 2,
              "ESXi Host": 1,
              "Power": 4,
              "VM": 0
            },
            "renameByName": {
              "boot_time": "Boot time",
              "dc_name": "Datacenter",
              "ds_name": "Datastore",
              "host_name": "ESXi Host",
              "power": "Power",
              "vm_name": "VM"
            }
          }
        }
      ],
      "type": "table"
    }
