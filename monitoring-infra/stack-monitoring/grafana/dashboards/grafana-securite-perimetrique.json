    {
      "type": "table",
      "title": "Inventaire des alertes",
      "id": 17,
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Date",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Action"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ban": {
                        "text": "ban",
                        "color": "red",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "queryType": "range",
          "maxLines": 500,
          "expr": "{job=\"crowdsec\"} | json ip, country, as_name, scenario, remediation, fqdn=\"meta.target_fqdn\", uri=\"meta.uri\", action=\"decisions[0].type\", duration=\"decisions[0].duration\""
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "tsNs": true,
              "id": true,
              "labels": true,
              "job": true,
              "host": true,
              "service_name": true,
              "detected_level": true,
              "remediation": true,
              "labelTypes": true
            },
            "indexByName": {
              "Time": 0,
              "ip": 1,
              "country": 2,
              "as_name": 3,
              "scenario": 4,
              "fqdn": 5,
              "uri": 6,
              "action": 7,
              "duration": 8
            },
            "renameByName": {
              "Time": "Date",
              "ip": "IP",
              "country": "Pays",
